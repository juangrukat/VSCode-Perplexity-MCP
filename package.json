{
  "name": "perplexity-mcp-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Perplexity MCP server for Claude Code and Codex CLI",
  "workspaces": [
    "packages/mcp-server"
  ],
  "scripts": {
    "build": "npm run build -w perplexity-user-mcp",
    "typecheck": "npm run typecheck -w perplexity-user-mcp",
    "test": "PERPLEXITY_DISABLE_KEYCHAIN=1 vitest run packages/mcp-server/test",
    "clean": "rimraf packages/mcp-server/dist",
    "test:coverage": "PERPLEXITY_DISABLE_KEYCHAIN=1 vitest run --coverage packages/mcp-server/test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "patchright": "^1.59.4",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.4",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.0"
  }
}
